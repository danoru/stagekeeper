generator client {
  provider        = "prisma-client-js"
  // relationJoins loads related rows with SQL joins instead of one query per relation.
  previewFeatures = ["driverAdapters", "postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext(schema: "public"), uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model attendance {
  id           Int                   @id @default(autoincrement())
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  comment      String?
  rating       Decimal?              @db.Decimal
  performance  Int?
  user         Int?
  musical      Int?
  play         Int?
  theatre      Int?
  seenDate     DateTime?             @db.Date
  going        Boolean               @default(false)
  /// The run this visit belongs to: same show, same theatre, dated inside the run. Set when
  /// the visit is saved and backfilled by migration; null when the visit has no theatre or date.
  programming  Int?
  performances performances?         @relation(fields: [performance], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programmings programming?          @relation(fields: [programming], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users        users?                @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)
  musicals     musicals?             @relation(fields: [musical], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plays        plays?                @relation(fields: [play], references: [id], onDelete: NoAction, onUpdate: NoAction)
  theatres     theatres?             @relation(fields: [theatre], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companions   attendanceCompanion[] @relation("CompanionVisit")
  joinedFrom   attendanceCompanion[] @relation("CompanionLinkedVisit")

  @@index([user])
  @@index([performance])
  @@index([user, performance])
  @@index([musical])
  @@index([play])
  @@index([theatre])
  @@index([programming])
  @@index([seenDate])
  @@index([going, seenDate])
}

model following {
  user              Int
  followingUsername String
  users             users  @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user, followingUsername])
  @@index([followingUsername])
}

model groups {
  id          Int               @id(map: "group_pkey") @default(autoincrement())
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  name        String
  inviteToken String            @unique @default(uuid())
  members     groupMembership[]
  invites     groupInvite[]
  plans       groupPlan[]
}

model groupMembership {
  group    Int
  user     Int
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now()) @db.Timestamptz(6)
  groups   groups    @relation(fields: [group], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users    users     @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([group, user])
  @@index([user])
  @@index([group])
}

/// An owner's request for someone to join. Membership (and seeing each other's going dates)
/// starts only when the invitee accepts.
model groupInvite {
  group     Int
  user      Int
  invitedBy Int?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  groups    groups   @relation(fields: [group], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users    @relation("GroupInvitee", fields: [user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter   users?   @relation("GroupInviter", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@id([group, user])
  @@index([user])
}

model groupPlan {
  id           Int             @id @default(autoincrement())
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  group        Int
  programming  Int
  createdBy    Int
  note         String?
  status       PlanStatus      @default(POLLING)
  selectedDate Int?
  groups       groups          @relation(fields: [group], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programmings programming     @relation(fields: [programming], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users           @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selected     groupPlanDate?  @relation("PlanSelectedDate", fields: [selectedDate], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dates        groupPlanDate[] @relation("PlanCandidateDates")

  @@index([group])
  @@index([programming])
  @@index([createdBy])
  @@index([status])
}

model groupPlanDate {
  id           Int                     @id @default(autoincrement())
  createdAt    DateTime                @default(now()) @db.Timestamptz(6)
  plan         Int
  startTime    DateTime                @db.Timestamptz(6)
  proposedBy   Int
  plans        groupPlan               @relation("PlanCandidateDates", fields: [plan], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users                   @relation(fields: [proposedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  selectedFor  groupPlan[]             @relation("PlanSelectedDate")
  availability groupPlanAvailability[]

  @@unique([plan, startTime], map: "groupPlanDate_unique_per_plan")
  @@index([plan])
  @@index([proposedBy])
}

model groupPlanAvailability {
  planDate  Int
  user      Int
  status    Availability
  updatedAt DateTime      @default(now()) @db.Timestamptz(6)
  dates     groupPlanDate @relation(fields: [planDate], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     users         @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([planDate, user])
  @@index([user])
  @@index([planDate])
}

model likedShows {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  type      PerformanceType
  user      Int
  musical   Int?
  play      Int?
  musicals  musicals?       @relation(fields: [musical], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_musical_fkey")
  plays     plays?          @relation(fields: [play], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_play_fkey")
  users     users           @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user, musical])
  @@unique([user, play])
  @@index([user])
  @@index([musical])
  @@index([play])
}

model musicals {
  id               Int                @id @default(autoincrement())
  title            String             @unique
  playbill         String             @default("https://picsum.photos/649/1024")
  duration         Int?
  musicBy          String
  lyricsBy         String
  bookBy           String
  premiere         DateTime?          @db.Date
  status           ContentStatus      @default(APPROVED)
  createdBy        Int?
  creator          users?             @relation("MusicalCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance       attendance[]
  likedShows       likedShows[]
  performances     performances[]
  programming      programming[]
  watchlist        watchlist[]
  importCandidates importCandidates[]

  @@index([status])
}

model performances {
  id           Int               @id(map: "showings_pkey") @default(autoincrement())
  type         PerformanceType
  play         Int?
  musical      Int?
  theatre      Int
  startTime    DateTime          @db.Timestamptz(6)
  endTime      DateTime          @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  /// The run this showtime belongs to. Null on older rows, whose startTime is a calendar day
  /// stored at UTC midnight rather than a real instant.
  programming  Int?
  status       PerformanceStatus @default(SCHEDULED)
  /// "Preview", "Opening night", "ASL interpreted"...
  label        String?
  programmings programming?      @relation(fields: [programming], references: [id], onDelete: SetNull, onUpdate: NoAction)
  attendance   attendance[]
  musicals     musicals?         @relation(fields: [musical], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_musical_fkey")
  plays        plays?            @relation(fields: [play], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_play_fkey")
  theatres     theatres          @relation(fields: [theatre], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_theatre_fkey")

  @@unique([programming, startTime])
  @@index([musical])
  @@index([play])
  @@index([theatre])
  @@index([startTime])
  @@index([theatre, startTime])
}

model plays {
  id               Int                @id @default(autoincrement())
  title            String             @unique
  playbill         String             @default("https://picsum.photos/649/1024")
  duration         Int?
  writtenBy        String
  premiere         DateTime?          @db.Date
  status           ContentStatus      @default(APPROVED)
  createdBy        Int?
  creator          users?             @relation("PlayCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance       attendance[]
  likedShows       likedShows[]
  performances     performances[]
  programming      programming[]
  watchlist        watchlist[]
  importCandidates importCandidates[]

  @@index([status])
}

model programming {
  id           Int             @id @default(autoincrement())
  createdAt    DateTime        @default(now()) @db.Timestamptz(6)
  type         PerformanceType
  play         Int?
  musical      Int?
  season       Int?
  startDate    DateTime        @db.Timestamptz(6)
  endDate      DateTime        @db.Timestamptz(6)
  dayTimes     Json
  musicals     musicals?       @relation(fields: [musical], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_musical_fkey")
  plays        plays?          @relation(fields: [play], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_play_fkey")
  seasons      seasons?        @relation(fields: [season], references: [id], onDelete: NoAction, onUpdate: NoAction)
  groupPlans   groupPlan[]
  credits      credits[]
  performances performances[]
  attendance   attendance[]

  @@index([musical])
  @@index([play])
  @@index([season])
}

/// A performer or creative. Pages are rendered on demand, so one-off people cost nothing.
model people {
  id            Int           @id @default(autoincrement())
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  name          String
  slug          String        @unique
  bio           String?
  /// Tells apart different people with the same name ("San Diego", "b. 1990"). Shown after
  /// the name in search, suggestions and on the person's page.
  disambiguator String?
  status        ContentStatus @default(PENDING)
  createdBy     Int?
  creator       users?        @relation("PersonCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)
  credits       credits[]

  @@index([name])
  @@index([status])
}

/// One person's part in one production (a programming run). Anyone who has seen the show can
/// suggest credits; they stay PENDING until an admin approves them.
model credits {
  id           Int            @id @default(autoincrement())
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  programming  Int
  person       Int
  category     CreditCategory
  /// Job title for creatives, musicians and crew ("Director", "Keys 1").
  role         String?
  /// Character for cast ("Seymour", "Ensemble").
  character    String?
  billing      Int            @default(0)
  status       ContentStatus  @default(PENDING)
  suggestedBy  Int?
  programmings programming    @relation(fields: [programming], references: [id], onDelete: Cascade, onUpdate: NoAction)
  people       people         @relation(fields: [person], references: [id], onDelete: Cascade, onUpdate: NoAction)
  suggester    users?         @relation("CreditSuggester", fields: [suggestedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([programming])
  @@index([person])
  @@index([status])
}

model seasons {
  id          Int           @id @default(autoincrement())
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  theatre     Int
  name        String
  startDate   DateTime      @db.Timestamptz(6)
  endDate     DateTime      @db.Timestamptz(6)
  programming programming[]
  theatres    theatres      @relation(fields: [theatre], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([theatre])
}

model theatres {
  id               Int                @id(map: "playhouses_pkey") @default(autoincrement())
  name             String
  link             String?
  location         String
  image            String             @default("https://picsum.photos/649/1024")
  address          String?
  status           ContentStatus      @default(APPROVED)
  /// IANA zone the theatre's clocks read in. Imported and generated showtimes use it.
  timeZone         String             @default("America/Los_Angeles")
  createdBy        Int?
  /// Page to scrape for season programming; falls back to `link` when null.
  seasonUrl        String?
  /// Optional CSS-selector overrides for the season importer.
  scrapeConfig     Json?
  creator          users?             @relation("TheatreCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attendance       attendance[]
  performances     performances[]
  seasons          seasons[]
  importCandidates importCandidates[]
  importRuns       importRuns[]
  homeFor          theatreFollows[]
  notes            theatreNotes[]

  @@index([status])
}

/// A theatre a member goes to often. Private: a list of home theatres says roughly where
/// someone lives, so it shapes only that member's own home page and never shows on profiles.
model theatreFollows {
  user      Int
  theatre   Int
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  users     users    @relation(fields: [user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  theatres  theatres @relation(fields: [theatre], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user, theatre])
  @@index([theatre])
}

/// A short "know before you go" tip about a theatre (parking, seats, late seating), written by
/// a member with a visit there. Shown once an admin approves it.
model theatreNotes {
  id        Int                @id @default(autoincrement())
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  theatre   Int
  user      Int?
  category  String
  text      String
  status    ContentStatus      @default(PENDING)
  theatres  theatres           @relation(fields: [theatre], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users?             @relation(fields: [user], references: [id], onDelete: SetNull, onUpdate: NoAction)
  votes     theatreNoteVotes[]

  @@index([theatre, status])
  @@index([user])
}

/// "Helpful" on a theatre note, one per member.
model theatreNoteVotes {
  note      Int
  user      Int
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  notes     theatreNotes @relation(fields: [note], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users        @relation(fields: [user], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([note, user])
}

/// "Went together": the owner of a past visit tags someone who came. Nothing shows until the
/// tagged member accepts, which adds the visit to their log (linkedAttendance).
model attendanceCompanion {
  id               Int             @id @default(autoincrement())
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  attendance       Int
  user             Int
  taggedBy         Int
  status           CompanionStatus @default(PENDING)
  linkedAttendance Int?
  visit            attendance      @relation("CompanionVisit", fields: [attendance], references: [id], onDelete: Cascade, onUpdate: NoAction)
  linked           attendance?     @relation("CompanionLinkedVisit", fields: [linkedAttendance], references: [id], onDelete: SetNull, onUpdate: NoAction)
  users            users           @relation("CompanionTagged", fields: [user], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tagger           users           @relation("CompanionTagger", fields: [taggedBy], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([attendance, user])
  @@index([user, status])
}

/// A run extracted from a theatre's season page, awaiting admin review.
model importCandidates {
  id                  Int                  @id @default(autoincrement())
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  theatre             Int
  sourceUrl           String
  rawTitle            String
  startDate           DateTime?            @db.Timestamptz(6)
  endDate             DateTime?            @db.Timestamptz(6)
  snippet             String?
  /// ISO instants of individual performances found on the page, if it listed them.
  showtimes           Json?
  /// Cast found in the page's structured data: [{ name, character }]. Offered as pending credits.
  cast                Json?
  matchType           PerformanceType?
  matchMusical        Int?
  matchPlay           Int?
  existingProgramming Int?
  state               ImportCandidateState @default(NEW)
  theatres            theatres             @relation(fields: [theatre], references: [id], onDelete: Cascade, onUpdate: NoAction)
  musicals            musicals?            @relation(fields: [matchMusical], references: [id], onDelete: SetNull, onUpdate: NoAction)
  plays               plays?               @relation(fields: [matchPlay], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([theatre, state])
}

/// One scrape attempt per theatre; powers the "last imported" column.
model importRuns {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  theatre   Int
  sourceUrl String
  status    String
  itemCount Int      @default(0)
  error     String?
  theatres  theatres @relation(fields: [theatre], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([theatre, createdAt])
}

model users {
  id                   Int                     @id @default(autoincrement())
  createdAt            DateTime                @default(now()) @db.Timestamptz(6)
  username             String                  @unique @db.Citext
  email                String                  @unique @db.Citext
  password             String
  firstName            String?
  lastName             String?
  location             String?
  website              String?
  bio                  String?
  image                String?
  badge                Badge                   @default(USER)
  onboardedAt          DateTime?               @db.Timestamptz(6)
  passwordResetToken   String?                 @unique
  passwordResetExpires DateTime?               @db.Timestamptz(6)
  /// Sessions signed in before this are revoked.
  passwordChangedAt    DateTime?               @db.Timestamptz(6)
  emailVerifiedAt      DateTime?               @db.Timestamptz(6)
  emailVerifyToken     String?                 @unique
  emailVerifyExpires   DateTime?               @db.Timestamptz(6)
  reportsFiled         reports[]
  musicalsCreated      musicals[]              @relation("MusicalCreator")
  playsCreated         plays[]                 @relation("PlayCreator")
  theatresCreated      theatres[]              @relation("TheatreCreator")
  attendance           attendance[]
  following            following[]
  likedShows           likedShows[]
  memberships          groupMembership[]
  plansCreated         groupPlan[]
  datesProposed        groupPlanDate[]
  availability         groupPlanAvailability[]
  watchlist            watchlist[]
  groupInvites         groupInvite[]           @relation("GroupInvitee")
  groupInvitesSent     groupInvite[]           @relation("GroupInviter")
  peopleCreated        people[]                @relation("PersonCreator")
  creditsSuggested     credits[]               @relation("CreditSuggester")
  homeTheatres         theatreFollows[]
  theatreNotes         theatreNotes[]
  theatreNoteVotes     theatreNoteVotes[]
  companionTags        attendanceCompanion[]   @relation("CompanionTagged")
  companionTagsSent    attendanceCompanion[]   @relation("CompanionTagger")
}

model watchlist {
  id        Int             @id @default(autoincrement())
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  type      PerformanceType
  user      Int
  play      Int?
  musical   Int?
  musicals  musicals?       @relation(fields: [musical], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_musical_fkey")
  plays     plays?          @relation(fields: [play], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "showings_play_fkey")
  users     users           @relation(fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user, musical])
  @@unique([user, play])
  @@index([user])
  @@index([musical])
  @@index([play])
}

enum Badge {
  ADMIN
  PATRON
  USER
}

enum ContentStatus {
  PENDING
  APPROVED
}

enum GroupRole {
  OWNER
  MEMBER
}

enum PlanStatus {
  POLLING
  CONFIRMED
  CANCELED
}

enum Availability {
  UNAVAILABLE
  AVAILABLE
  PREFER
  GOING
}

enum PerformanceType {
  MUSICAL
  PLAY
}

/// Fixed-window request counts, shared across serverless instances.
model rateLimits {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(6)

  @@index([resetAt])
}

/// Something a member flagged for an admin to look at. The label is kept so a report still
/// reads sensibly after its target is removed.
model reports {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  reporter   Int?
  targetType ReportTarget
  targetId   Int
  label      String
  reason     String
  details    String?
  resolvedAt DateTime?    @db.Timestamptz(6)
  users      users?       @relation(fields: [reporter], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([resolvedAt])
  @@index([reporter])
}

enum ReportTarget {
  MUSICAL
  PLAY
  THEATRE
  PERSON
  USER
  THEATRE_NOTE
}

enum PerformanceStatus {
  SCHEDULED
  CANCELED
  SOLD_OUT
}

enum CreditCategory {
  CAST
  CREATIVE
  MUSICIAN
  CREW
  /// Understudies, swings and standbys; `character` lists the parts covered ("Seymour, Orin").
  UNDERSTUDY
}

enum CompanionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ImportCandidateState {
  NEW
  DUPLICATE
  APPROVED
  SKIPPED
}
